#version 450
// Per row count of pixels whose luma (Y) differs by more than the threshold, one workgroup per row.
// The Y planes are copied from the decoded images into buffers with 4 pixels per word,
// row_words words per row.

layout(local_size_x = 128) in;

layout(std430, set = 0, binding = 0) readonly  buffer CurrentLuma  { uint current_luma[]; };
layout(std430, set = 0, binding = 1) readonly  buffer PreviousLuma { uint previous_luma[]; };
layout(std430, set = 0, binding = 2) writeonly buffer RowCounts    { uint row_counts[]; };

layout(push_constant) uniform Parameters {
    uint width;
    uint row_words;
    uint threshold;   // pixel_difference: a pixel differs if |a - b| > threshold
} params;

shared uint partial_counts[128];

void main()
{
    const uint row = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    const uint groups = (params.width + 3u) / 4u;

    uint count = 0u;
    for (uint q = lane; q < groups; q += gl_WorkGroupSize.x)
    {
        const uint index = row * params.row_words + q;
        const uint a = current_luma[index];
        const uint b = previous_luma[index];
        const uint valid = min(params.width - q * 4u, 4u);
        for (uint k = 0u; k < valid; ++k)
        {
            const int pa = int((a >> (8u * k)) & 0xFFu);
            const int pb = int((b >> (8u * k)) & 0xFFu);
            if (uint(abs(pa - pb)) > params.threshold) count += 1u;
        }
    }

    partial_counts[lane] = count;
    barrier();
    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride /= 2u)
    {
        if (lane < stride) partial_counts[lane] += partial_counts[lane + stride];
        barrier();
    }
    if (lane == 0u) row_counts[row] = partial_counts[0];
}
