<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Trdrop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/chart_series_1</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/chart_surface</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chart_text_primary</item>
    </style>

    <style name="Secondary">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/chart_text_secondary</item>
    </style>
</resources>
